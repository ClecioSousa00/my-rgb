{
  "name": "my-rgb",
  "version": "0.1.0",
  "description": "Cross-platform RGB control for ASUS AURA USB controllers - identical effects on Linux and Windows",
  "main": "./out/main/index.js",
  "desktopName": "my-rgb",
  "author": {
    "name": "my-rgb",
    "email": "my-rgb@users.noreply.github.com"
  },
  "homepage": "https://github.com/my-rgb/my-rgb",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node tools/check-hid-binary.mjs",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:win:dir": "npm run build && electron-builder --win dir --publish never --config.win.signAndEditExecutable=false",
    "build:dir": "npm run build && electron-builder --dir --publish never",
    "icons": "node tools/gen-icons.mjs",
    "probe": "node tools/probe-aura.mjs",
    "dump:frames": "npm run build && electron . --dump-frames",
    "write-test": "npm run build && electron . --write-test",
    "selftest": "npm run build && electron . --selftest"
  },
  "dependencies": {
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
